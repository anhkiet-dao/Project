<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/rounded_button_pressed"/> <!-- màu khi nhấn -->
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/rounded_button_normal"/> <!-- màu bình thường -->
            <stroke android:width="1dp" android:color="@color/rounded_button_stroke"/> <!-- viền mảnh -->
        </shape>
    </item>
</selector>
