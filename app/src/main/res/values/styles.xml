<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MyBottomNavStyle">
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemBackground">@null</item>
        <item name="itemRippleColor">@null</item>
        <item name="itemIconSize">20sp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@drawable/bg_bottom_nav</item>

        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>

