<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".application.SettingsActivity">

    <!-- Khung chính nằm giữa màn hình -->
    <LinearLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:layout_margin="24dp"
        android:padding="20dp"
        android:elevation="6dp">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cài đặt hiển thị"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Thanh chia -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:alpha="0.1"
            android:layout_marginBottom="20dp" />

        <!-- Switch hiển thị thanh điều hướng -->
        <Switch
            android:id="@+id/switch_show_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hiển thị thanh điều hướng"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:padding="8dp" />

        <!-- Switch chế độ tối -->
        <Switch
            android:id="@+id/switch_dark_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chế độ tối (Dark Mode)"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:padding="8dp"
            android:layout_marginBottom="30dp" />

        <!-- Nút đóng -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đóng"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:padding="10dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</RelativeLayout>
