<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="47dp">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/img_2" />

        <TextView
            android:id="@+id/txtTieuDe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:text="Tên sách"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Yêu thích"
                android:src="@drawable/img_3" />

            <ImageView
                android:id="@+id/btnDown"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:contentDescription="Tải xuống"
                android:src="@drawable/img_4" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Cài đặt"
                android:src="@drawable/img_13" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_pdf_frame"
        android:elevation="8dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pdfViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBarLoading"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đang tải..."
                android:textColor="@android:color/background_dark"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="#80000000"
            android:padding="4dp"
            android:text="0/0"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnNote"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:contentDescription="Ghi chú"
            android:elevation="12dp"
            android:padding="8dp"
            android:src="@drawable/ic_note" />

        <ProgressBar
            android:id="@+id/progressDownload"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:padding="24dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_settings_card"
                android:elevation="12dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="12dp"
                    android:text="Cài đặt"
                    android:textColor="@color/color_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chiều đọc:"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgReadingDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="4dp">

                    <RadioButton
                        android:id="@+id/rbVertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dọc"
                        android:textColor="@color/color_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbHorizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngang"
                        android:textColor="@color/color_text_secondary" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Hiển thị trang:"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPageMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="4dp">

                    <RadioButton
                        android:id="@+id/rbSinglePage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 trang / lần"
                        android:textColor="@color/color_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbDoublePage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 trang / lần"
                        android:textColor="@color/color_text_secondary" />
                </RadioGroup>

                <Switch
                    android:id="@+id/switchAutoNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tự động chuyển trang"
                    android:textColor="@color/color_text_primary" />

                <LinearLayout
                    android:id="@+id/layoutAutoTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian:"
                        android:textColor="@color/color_text_secondary" />

                    <SeekBar
                        android:id="@+id/seekAutoTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="30" />

                    <TextView
                        android:id="@+id/txtAutoTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="8dp"
                        android:text="5s"
                        android:textColor="@color/color_text_primary" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/color_accent"
                    android:text="Đóng"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>